{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteVersionedLambdaArtifact",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::stayrate-<stage>-artifacts-<account-id>-<region>/lambda/*"
    },
    {
      "Sid": "CreateChangesForOneStayRateStack",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::<account-id>:role/stayrate-<stage>-cloudformation"
        }
      }
    },
    {
      "Sid": "InspectAndExecuteChangesForOneStayRateStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*"
    },
    {
      "Sid": "PassOneExecutionRoleToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<account-id>:role/stayrate-<stage>-cloudformation",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
