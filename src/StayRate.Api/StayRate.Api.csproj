<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StayRate.Application\StayRate.Application.csproj" />
    <ProjectReference Include="..\StayRate.Infrastructure\StayRate.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CreateLambdaBootstrap" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)StayRate.Api" DestinationFiles="$(PublishDir)bootstrap" SkipUnchangedFiles="true" />
  </Target>

</Project>
